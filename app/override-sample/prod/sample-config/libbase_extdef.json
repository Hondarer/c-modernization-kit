///////////////////////////////////////////////////////////////////////////////
//
// override-sample 構成定義ファイル サンプル
//
// override-sample は、/tmp/{ライブラリ名}_extdef.json を読み込み、
// 差し替え実装の呼び出しを制御します。
//
// キーは差し替え可能な公開関数名 (差し替えキー) です。
// func には差し替え側ライブラリの関数名 ({ライブラリ接頭辞}_{動詞}、必要なら末尾に _{実装の特徴}) を指定します。
//
// 本ファイルを /tmp に配置することで動作を制御できます。
// Windows 環境では、/tmp を %TEMP% に置き換えて適用してください。
//
// コメントは // 行コメントおよび C 形式のブロック コメントを利用できます。
//
///////////////////////////////////////////////////////////////////////////////

{
  // 明示的に既定の処理を行いたい場合
  // 定義項目を明示しない、または定義ファイルを配置しないことで
  // 既定の処理が実行されますが、明示的に既定の処理を指定することもできます。
  "base_calc": {
    "lib": "default",
    "func": "default"
  }

  // 差し替え実装を有効にする場合
  //"base_calc": {
  //  "lib": "liboverride",
  //  "func": "override_calc"
  //}
}
