///////////////////////////////////////////////////////////////////////////////
//
// override-sample 構成定義ファイル サンプル
//
// override-sample は、/tmp/{ライブラリ名}_extdef.json を読み込み、
// 拡張処理の呼び出しを制御します。
//
// 本ファイルを /tmp に配置することで動作を制御できます。
// ※ Windows 環境では /tmp を %TEMP% と読み替えてください。
//
// コメントは // 行コメントおよび C 形式のブロック コメントを利用できます。
//
///////////////////////////////////////////////////////////////////////////////

{
  // 明示的に既定の処理を行いたい場合
  // 定義項目を明示しない、または定義ファイルを配置しないことで
  // 既定の処理になりますが、明示的に既定処理を強制することもできます。
  "sample_func": {
    "lib": "default",
    "func": "default"
  }

  // 拡張処理を有効にする場合
  //"sample_func": {
  //  "lib": "liboverride",
  //  "func": "override_func"
  //}
}
