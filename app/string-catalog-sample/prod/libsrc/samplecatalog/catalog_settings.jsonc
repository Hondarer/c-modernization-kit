// app 単位のカタログ設定です。
// この app のカタログ定義が settings から参照します。
//
// export は、カタログをライブラリの外部へ公開する場合の装飾を決めます。
// prefix からエクスポート マクロと呼び出し規約マクロの名前を導き、header をその定義元とします。
// 名前の導出は cplat/base/dll_exports.h の CPLAT_DLL_EXPORT(prefix) と同じ規約です。
//
// context は、この app が定める文脈引数です。トレース種別のカタログにだけ効きます。
// index は書式が参照する位置指定で、{46} から {49} までを指定できます。
// 外部へ公開するカタログでは、記載順の変更で番号が変わらないよう index の記載が必須です。
// 取得式は出力の要求ごとに評価されるため、軽量かつ失敗せず、スレッド セーフである必要があります。
// 取得関数は、利用側のコンパイル単位から呼ばれるためライブラリの外部へ公開します。
{
    "export": {
        "prefix": "SAMPLECATALOG",
        "header": "samplecatalog/samplecatalog_export.h"
    },
    "context": {
        "headers": ["samplecatalog/samplecatalog_context.h"],
        "arguments": [
            {
                "index": 46,
                "name": "sequence_number",
                "kind": "INT32",
                "description": "出力ごとに 1 から順に増え、上限に達すると 1 へ戻る試験用の連番。",
                "inline_value": "samplecatalog_next_sequence_number()"
            }
        ]
    }
}
